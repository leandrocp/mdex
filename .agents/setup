#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
SECONDS=0

# Match Dockerfile. Hex's Ubuntu 22.04 builds also run on Debian 12.
otp_version=27.3.4
elixir_version=1.18.3
toolchain="$HOME/.local/share/mdex-beam"
otp="$toolchain/otp-$otp_version"
elixir="$toolchain/elixir-$elixir_version-otp-27"

echo '==> Checking system packages'
packages=()
for package in ca-certificates curl unzip libssl3 libncurses6 libstdc++6 build-essential; do
  if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
    packages+=("$package")
  fi
done
if ((${#packages[@]})); then
  sudo apt-get update -qq
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${packages[@]}"
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

echo "==> Preparing OTP $otp_version and Elixir $elixir_version (${SECONDS}s)"
if [[ ! -f "$otp/.complete" ]]; then
  curl --fail --location --retry 3 \
    "https://builds.hex.pm/builds/otp/amd64/ubuntu-22.04/OTP-$otp_version.tar.gz" -o "$tmp/otp.tar.gz"
  echo "7b08206f8af76a3ebe895c1a58dda536d21134c02880fe05efec19d37d49eb9c  $tmp/otp.tar.gz" | sha256sum --check
  rm -rf "$otp"
  mkdir -p "$otp"
  tar -xzf "$tmp/otp.tar.gz" --strip-components=1 -C "$otp"
  "$otp/Install" -minimal "$otp"
  touch "$otp/.complete"
fi
if [[ ! -f "$elixir/.complete" ]]; then
  curl --fail --location --retry 3 \
    "https://builds.hex.pm/builds/elixir/v$elixir_version-otp-27.zip" -o "$tmp/elixir.zip"
  echo "9ea6a5dc238bf9dcaaa2b6660c2bb2e36fd889004dde86d8a1c122cc68665476  $tmp/elixir.zip" | sha256sum --check
  rm -rf "$elixir"
  mkdir -p "$elixir"
  unzip -q -o "$tmp/elixir.zip" -d "$elixir"
  touch "$elixir/.complete"
fi
export PATH="$elixir/bin:$otp/bin:$PATH"

# Amp and supervised services use new non-interactive login shells.
if [[ ! -e "$HOME/.bash_profile" ]]; then
  for profile in .bash_login .profile; do
    if [[ -f "$HOME/$profile" ]]; then
      printf '[[ ! -f "$HOME/%s" ]] || source "$HOME/%s"\n' "$profile" "$profile" > "$HOME/.bash_profile"
      break
    fi
  done
fi
marker="# MDEx orb toolchain: $PWD ($otp_version/$elixir_version)"
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$marker
case "\$PWD/" in
  "$PWD/"*)
    case ":\$PATH:" in
      *":$elixir/bin:$otp/bin:"*) ;;
      *) export PATH="$elixir/bin:$otp/bin:\$PATH" ;;
    esac
    ;;
esac
EOF
fi

echo "==> Preparing Hex and Rebar (${SECONDS}s)"
mix local.hex --if-missing --force
mix local.rebar --if-missing --force

# Fetch locked dependencies once, then retain both build environments in snapshots.
echo "==> Fetching locked dependencies (${SECONDS}s)"
mix deps.get --check-locked
for environment in dev test; do
  echo "==> Compiling $environment (${SECONDS}s)"
  MIX_ENV="$environment" mix compile
done

echo "==> Orb setup ready (${SECONDS}s)"
